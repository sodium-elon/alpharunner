{
  "name": "alpharunner",
  "version": "0.1.3",
  "private": true,
  "description": "AlphaRunner MVP - dashboard and control center for tracking runs",
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "coach": "tsx scripts/coach.ts",
    "predev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev": "dotenv -e ../env-profiles/local.env -- vite dev --host 0.0.0.0 --strictPort",
    "dev:msw": "dotenv -e ../env-profiles/local.env -- sh -c 'MSW=true vite dev --host 0.0.0.0 --strictPort'",
    "dev:prod": "dotenv -e ../env-profiles/prod.env -- vite dev --strictPort",
    "build": "pnpm build:local",
    "build:local": "dotenv -e ../env-profiles/local.env -- vite build",
    "build:prod": "dotenv -e ../env-profiles/prod.env -- vite build",
    "build:msw": "dotenv -e ../env-profiles/prod.env -- sh -c 'MSW=true vite build'",
    "preview": "dotenv -e ../env-profiles/local.env -- vite preview",
    "preview:prod": "dotenv -e ../env-profiles/prod.env -- vite preview",
    "start": "dotenv -e ../env-profiles/local.env -- node .output/server/index.mjs",
    "start:prod": "dotenv -e ../env-profiles/prod.env -- node .output/server/index.mjs",
    "start:msw": "dotenv -e ../env-profiles/prod.env -- sh -c 'MSW=true node .output/server/index.mjs'",
    "db:generate": "dotenv -e ../env-profiles/local.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../env-profiles/local.env -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../env-profiles/local.env -- drizzle-kit push",
    "db:push:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../env-profiles/local.env -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit studio",
    "db:import-seed": "dotenv -e ../env-profiles/local.env -- tsx src/db/import-seed.ts",
    "db:sync-garmin": "dotenv -e ../env-profiles/local.env -- tsx scripts/garmin/sync.ts",
    "db:sync-garmin:prod": "dotenv -e ../env-profiles/prod.env -- tsx scripts/garmin/sync.ts",
    "best-run": "dotenv -e ../env-profiles/local.env -- tsx scripts/best-run.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "test": "vitest",
    "test:coach:postgres": "dotenv -e ../env-profiles/local.env -- tsx scripts/verify-coach-correction.mjs",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.77.0",
    "nitro": "3.0.261103-rc",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.38.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.8",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tanstack/react-query-devtools": "^5.108.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lefthook": "2.2.2",
    "msw": "^3.0.7",
    "storybook": "^10.6.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
